# Refuse to install on a Node older than `engines` in package.json
# (propslab-ent #1600). Without it npm only warns, and the first real error on
# an old Node arrives minutes into setup from whichever tool trips first.
# npm checks `engines` only after it resolves the tree, so a resolution error
# can still come first. `devEngines` in package.json is checked before
# resolution, and is what names the wrong Node on npm 10.9.0 and later (#58).
# This line covers an older npm, which ignores `devEngines`. The floor itself
# lives in `.nvmrc`, `engines` and `devEngines`; this only makes npm hold to it.
#
# It applies to every dependency's `engines` too, so a package that declares a
# range this repository's Node falls outside of fails `npm ci` rather than
# installing and failing later.
engine-strict=true
