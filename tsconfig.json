{
  // The type-check: every source file, its tests and the config files that are
  // TypeScript, emitting nothing. `npm run typecheck`. ESLint's type-aware rules
  // resolve files through this project too (projectService), so a file not
  // included here is a file the typed lint rules cannot see.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "vitest.config.ts"]
}
